  {
    "id": "d4bbac48-a444-49e0-aedb-9af5273b88df",
    "name": "AI Image Generator",
    "icon": "image_search",
    "color": null,
    "description": "Generates a featured image for a post and saves it to the file library. Uses OpenAI by default: add a key in Settings → AI (or pick a Google model in the Image step), then set this flow to Active.",
    "status": "inactive",
    "trigger": "manual",
    "accountability": "all",
    "options": {
      "collections": [
        "posts"
      ],
      "location": "item",
      "requireConfirmation": true,
      "confirmationDescription": "AI Image Generator",
      "fields": [
        {
          "field": "prompt",
          "type": "text",
          "name": "Prompt",
          "meta": {
            "interface": "input-multiline",
            "width": "full",
            "required": true,
            "note": "Describe the image you want. The more descriptive, the better the results.",
            "options": {
              "placeholder": "A hand-drawn marker style illustration with a whimsical theme, using bold, uneven marker-style lines on a white background."
            }
          }
        },
        {
          "field": "colors",
          "type": "json",
          "name": "Colors",
          "meta": {
            "interface": "list",
            "note": "Optional color palette. Color names alongside hex codes tend to give better results.",
            "options": {
              "template": "{{ name }} {{ color }}",
              "fields": [
                {
                  "field": "color",
                  "name": "Color",
                  "type": "string",
                  "meta": {
                    "width": "half",
                    "interface": "select-color"
                  }
                },
                {
                  "field": "name",
                  "name": "Name",
                  "type": "string",
                  "meta": {
                    "width": "half",
                    "interface": "input"
                  }
                }
              ]
            }
          }
        },
        {
          "field": "aspect_ratio",
          "type": "string",
          "name": "Aspect Ratio",
          "schema": {
            "default_value": "16:9"
          },
          "meta": {
            "interface": "select-radio",
            "width": "full",
            "options": {
              "choices": [
                {
                  "text": "16:9",
                  "value": "16:9"
                },
                {
                  "text": "1:1",
                  "value": "1:1"
                },
                {
                  "text": "9:16",
                  "value": "9:16"
                }
              ]
            }
          }
        }
      ],
      "error_on_reject": true
    },
